local draggingSlider = false
local function updateSlider(input)
    local posY = math.clamp(input.Position.Y - SliderContainer.AbsolutePosition.Y, 0, SliderContainer.AbsoluteSize.Y)
    local pct = 1 - (posY / SliderContainer.AbsoluteSize.Y)
    spd = math.floor(100 + pct * 500)
    SliderFill.Size = UDim2.new(1, 0, pct, 0)
    SliderFill.Position = UDim2.new(0, 0, 1 - pct, 0)
    SliderLabel.Text = spd .. " SPD"
end

SliderContainer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true; updateSlider(input) end
end)
UIS.InputChanged:Connect(function(input)
    if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end
end)

UIS.InputChanged:Connect(function(input)
    if fly and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and not draggingSlider then
        local delta = input.Delta
        local rotX = CFrame.Angles(0, -delta.X * 0.005, 0)
        local rotY = CFrame.Angles(-delta.Y * 0.005, 0, 0)
        currentCF = currentCF * rotX * rotY
    end
end)

local function toggleThermalVision()
    thermalActive = not thermalActive
    if thermalActive then
        BtnThermal.Text = "THERMAL: ON"
        BtnThermal.TextColor3 = Color3.fromRGB(255, 255, 255)
        CC.Enabled = true
        NoiseFrame.Visible = true
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character then
                for _, obj in pairs(plr.Character:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        coloredCharacters[obj] = obj.Color
                        obj.Color = Color3.fromRGB(255, 255, 255)
                        obj.Material = Enum.Material.Neon
                    end
                end
            end
        end
    else
        BtnThermal.Text = "THERMAL: OFF"
        BtnThermal.TextColor3 = Color3.fromRGB(100, 255, 100)
        CC.Enabled = false
        NoiseFrame.Visible = false
        for part, col in pairs(coloredCharacters) do
            if part and part.Parent then
                part.Color = col
                part.Material = Enum.Material.SmoothPlastic
            end
        end
        coloredCharacters = {}
    end
end
BtnThermal.MouseButton1Click:Connect(toggleThermalVision)

UIS.InputBegan:Connect(function(input, gpe)
    if not fly then return end
    if input.KeyCode == Enum.KeyCode.T then toggleThermalVision() end
    if input.KeyCode == Enum.KeyCode.Comma or input.KeyCode == Enum.KeyCode.LeftBracket then switchMissile(-1)
    elseif input.KeyCode == Enum.KeyCode.Period or input.KeyCode == Enum.KeyCode.RightBracket then switchMissile(1) end
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.W then moveF = true end
    if input.KeyCode == Enum.KeyCode.S then moveB = true end
    if input.KeyCode == Enum.KeyCode.Q then rollL = true end
    if input.KeyCode == Enum.KeyCode.E then rollR = true end
end)
UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then moveF = false end
    if input.KeyCode == Enum.KeyCode.S then moveB = false end
    if input.KeyCode == Enum.KeyCode.Q then rollL = false end
    if input.KeyCode == Enum.KeyCode.E then rollR = false end
end)

