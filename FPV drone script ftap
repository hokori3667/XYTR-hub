            if thermalActive then NoiseFrame.Visible = true end
            BF.Text = texts[currentLang].toggleOn
            BF.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
            applyDronePhysics(bestPart)
        else stopF(false) end
    else stopF(false) end
end)

