local function getCardinalDirection(lookVector)
    local x, z = lookVector.X, lookVector.Z
    local angle = math.deg(math.atan2(-z, x))
    if angle < 0 then angle = angle + 360 end
    if angle >= 337.5 or angle < 22.5 then return "EAST (+X)"
    elseif angle >= 22.5 and angle < 67.5 then return "NE"
    elseif angle >= 67.5 and angle < 112.5 then return "NORTH (-Z)"
    elseif angle >= 112.5 and angle < 157.5 then return "NW"
    elseif angle >= 157.5 and angle < 202.5 then return "WEST (-X)"
    elseif angle >= 202.5 and angle < 247.5 then return "SW"
    elseif angle >= 247.5 and angle < 292.5 then return "SOUTH (+Z)"
    elseif angle >= 292.5 and angle < 337.5 then return "SE"
    end
    return "NORTH"
end

RS.RenderStepped:Connect(function(dt)
    if fly then
        if activePart and activePart:IsDescendantOf(W) then
            Cam.CameraType = Enum.CameraType.Scriptable
            
            if rollL then currentCF = currentCF * CFrame.Angles(0, 0, 2.5 * dt * 2) end
            if rollR then currentCF = currentCF * CFrame.Angles(0, 0, -2.5 * dt * 2) end
            
            local moveVec = Vector3.zero
            if moveF then moveVec = moveVec + currentCF.LookVector end
            if moveB then moveVec = moveVec - currentCF.LookVector end
            if moveU then moveVec = moveVec + currentCF.UpVector end
            if moveD then moveVec = moveVec - currentCF.DownVector end

            currentVel = currentVel:Lerp(moveVec.Magnitude > 0 and moveVec.Unit * spd or Vector3.zero, 0.15)
            local currentSpd = math.floor(currentVel.Magnitude)
            if currentSpd > maxSpdAchieved then maxSpdAchieved = currentSpd end

            activeBodyVel.Velocity = currentVel
            activeBodyGyro.CFrame = CFrame.new(activePart.Position) * currentCF.Rotation

            for _, line in ipairs(scanlines) do line.Position = UDim2.new(0, 0, math.random(0, 100) / 100, 0) end
            if thermalActive then
                NoiseFrame.Visible = true
                NoiseFrame.BackgroundTransparency = math.random(90, 97) / 100
            else
                NoiseFrame.Visible = false
            end

            local rx, ry, rz = currentCF:ToEulerAnglesXYZ()
            local rollDeg = math.floor(math.deg(rz))
            local pitchDeg = math.floor(math.deg(rx))
            
            CrossText.Text = string.format("[ ROLL: %+d° | ACRO ]", rollDeg)

            local indicatorPos = math.clamp(0.5 + (rz / 1.5), 0.05, 0.95)
            HorizonIndicator.Position = UDim2.new(indicatorPos, -2, 0, 0)
            
            local climbRate = math.floor(activePart.Velocity.Y)
            HorizonLabel.Text = string.format("PITCH: %+d° | CLIMB: %+d s/s", pitchDeg, climbRate)

            local pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            local fpsVal = math.floor(1 / dt)
            StatusHUD.Text = string.format("WIFI: [||||] 5G | BAT: 95%%\nPING: %dms | FPS: %d", pingVal, fpsVal)

            local fDur = tick() - activationTime
            OwnerLabel.Text = getRocketOwnerName(activePart)
            
            local altVal = math.floor(activePart.Position.Y)
            local airTime = string.format("%.1fs", fDur)
            local headingStr = getCardinalDirection(currentCF.LookVector)
            local throttlePct = math.floor((currentSpd / spd) * 100)

            Info.Text = string.format("ALT: %d studs | AIR: %s\nMAX: %d s/s | SPS: %d s/s\nTHR: %d%% | DIR: %s\nTEMP: %d°C | THERMAL: %s", 
                altVal, airTime, maxSpdAchieved, currentSpd, throttlePct, headingStr, math.floor(35 + (currentSpd / 8) + (fDur * 1.8)), thermalActive and "ON" or "OFF"
            )

            local targetPos = activePart.Position
            if mode == "FPV" then
                Cam.CFrame = CFrame.new(targetPos) * currentCF.Rotation
            else
                local backVector = (CFrame.new(targetPos) * currentCF.Rotation).LookVector
                Cam.CFrame = CFrame.lookAt(targetPos - backVector * tpvD + Vector3.new(0, 3, 0), targetPos)
            end
        else
            stopF(false)
        end
    end
end)
