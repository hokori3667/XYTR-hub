local function isPartValidMissile(part)
    if not part:IsA("BasePart") or part.Anchored then return false end
    if LP.Character and part:IsDescendantOf(LP.Character) then return false end
    
    local model = part:FindFirstAncestorOfClass("Model")
    if model and (Players:GetPlayerFromCharacter(model) or model:FindFirstChildOfClass("Humanoid")) then return false end
    if part:FindFirstAncestorOfClass("Accessory") or part:FindFirstAncestorOfClass("Tool") then return false end
    if part.Size.Magnitude > 30 then return false end
    return true
end

local function getAllMissiles()
    local list = {}
    for _, o in pairs(W:GetDescendants()) do if isPartValidMissile(o) then table.insert(list, o) end end
    return list
end

local function getRocketOwnerName(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if model then
        local player = Players:GetPlayerFromCharacter(model)
        if player then return "rocket by " .. player.Name end
        for _, obj in pairs(model:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value and obj.Value:IsA("Player") then return "rocket by " .. obj.Value.Name
            elseif obj:IsA("StringValue") and (obj.Name:lower():find("owner") or obj.Name:lower():find("creator")) then return "rocket by " .. obj.Value end
        end
        if model.Name and Players:FindFirstChild(model.Name) then return "rocket by " .. model.Name end
    end
    return "rocket by " .. LP.Name
end

local function triggerExplosion(pos, missilePart)
    local p = Instance.new("Part")
    p.Size = Vector3.new(1, 1, 1)
    p.Position = pos
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = false
    p.Parent = W
    
    local fire = Instance.new("Fire", p)
    fire.Size = 15
    fire.Heat = 10
    local smoke = Instance.new("Smoke", p)
    smoke.Size = 25
    smoke.RiseVelocity = 10
    
    if missilePart and missilePart:IsA("BasePart") then missilePart:Destroy() end
    task.delay(1.5, function() p:Destroy() end)
end

local function restoreMissileTransparency()
    for part, trans in pairs(originalTransparency) do if part and part.Parent then part.Transparency = trans end end
    originalTransparency = {}
end

local function makeMissileInvisible(part)
    restoreMissileTransparency()
    local targetParts = part:FindFirstAncestorOfClass("Model") and part:FindFirstAncestorOfClass("Model"):GetDescendants() or {part}
    for _, obj in pairs(targetParts) do
        if obj:IsA("BasePart") then originalTransparency[obj] = obj.Transparency; obj.Transparency = 1 end
    end
end

local function stopF(exploded, hitPos, missilePart)
    fly = false
    HUD.Visible = false
    ScanlineContainer.Visible = false
    BtnThermal.Visible = false
    CtlFrame.Visible = false
    SwitchFrame.Visible = false
    SliderContainer.Visible = false
    TogMobBtn.Visible = false
    NoiseFrame.Visible = false
    BF.Text = texts[currentLang].toggleOff
    BF.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    
    restoreMissileTransparency()
    if thermalActive then thermalActive = false; CC.Enabled = false; BtnThermal.Text = "THERMAL: OFF"; BtnThermal.TextColor3 = Color3.fromRGB(100, 255, 100) end
    for part, col in pairs(coloredCharacters) do if part and part.Parent then part.Color = col; part.Material = Enum.Material.SmoothPlastic end end
    coloredCharacters = {}
    
    if exploded and hitPos then triggerExplosion(hitPos, missilePart) end
    if activeBodyVel then activeBodyVel:Destroy() end
    if activeBodyGyro then activeBodyGyro:Destroy() end
    if activeBodyForce then activeBodyForce:Destroy() end
    if touchedConn then touchedConn:Disconnect() end
    
    activePart, activeBodyVel, activeBodyGyro, activeBodyForce, touchedConn = nil, nil, nil, nil, nil
    currentVel = Vector3.zero
    Cam.CameraType = Enum.CameraType.Custom
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then Cam.CameraSubject = LP.Character.Humanoid end
end

local function applyDronePhysics(part)
    activePart = part
    activationTime = tick()
    currentVel = Vector3.zero
    maxSpdAchieved = 0
    
    if LP.Character then
        for _, joint in pairs(W:GetDescendants()) do
            if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                if (joint.Part0 and joint.Part0:IsDescendantOf(LP.Character)) or (joint.Part1 and joint.Part1:IsDescendantOf(LP.Character)) then
                    if joint.Part0 == activePart or joint.Part1 == activePart or (activePart.Parent and (joint.Part0:IsDescendantOf(activePart.Parent) or joint.Part1:IsDescendantOf(activePart.Parent))) then
                        joint:Destroy()
                    end
                end
            end
        end
    end

    makeMissileInvisible(activePart)
    
    local initDir = activePart.Velocity.Magnitude > 5 and activePart.Velocity.Unit or activePart.CFrame.LookVector
    if initDir.Magnitude == 0 then initDir = Vector3.new(0, 0, -1) end
    currentCF = CFrame.lookAt(activePart.Position, activePart.Position + initDir)

    activeBodyVel = Instance.new("BodyVelocity", activePart)
    activeBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    activeBodyVel.Velocity = Vector3.zero
    
    activeBodyGyro = Instance.new("BodyGyro", activePart)
    activeBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    activeBodyGyro.P = 50000
    
    activeBodyForce = Instance.new("BodyForce", activePart)
    activeBodyForce.Force = Vector3.new(0, activePart:GetMass() * W.Gravity, 0)
    
    touchedConn = activePart.Touched:Connect(function(hit)
        if fly and (tick() - activationTime > 0.3) and not (LP.Character and hit:IsDescendantOf(LP.Character)) and not hit:IsDescendantOf(activePart) then
            stopF(true, activePart.Position, activePart)
        end
    end)
end

local function switchMissile(direction)
    local missiles = getAllMissiles()
    if #missiles == 0 then return end
    local currentIndex = 1
    for i, m in ipairs(missiles) do if m == activePart then currentIndex = i; break end end
    currentIndex = currentIndex + direction
    if currentIndex > #missiles then currentIndex = 1 elseif currentIndex < 1 then currentIndex = #missiles end
    local newPart = missiles[currentIndex]
    if newPart and newPart ~= activePart then
        restoreMissileTransparency()
        if activeBodyVel then activeBodyVel:Destroy() end
        if activeBodyGyro then activeBodyGyro:Destroy() end
        if activeBodyForce then activeBodyForce:Destroy() end
        if touchedConn then touchedConn:Disconnect() end
        applyDronePhysics(newPart)
    end
end

