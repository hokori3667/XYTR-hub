BF.MouseButton1Click:Connect(function()
    fly = not fly
    if fly then
        local missiles, bestPart, shortestDist = getAllMissiles(), nil, math.huge
        local originPos = (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")) and LP.Character.HumanoidRootPart.Position or Cam.CFrame.Position
        for _, o in pairs(missiles) do
            local dist = (o.Position - originPos).Magnitude
            if dist < shortestDist then shortestDist = dist; bestPart = o end
        end
        if bestPart then
            HUD.Visible = true
            ScanlineContainer.Visible = true
            BtnThermal.Visible = true
            CtlFrame.Visible = mobVisible
